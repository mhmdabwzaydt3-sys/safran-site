---
import Base from '../layouts/Base.astro';
import allPostsData from '../data/posts.json';
const posts = allPostsData.filter((p: any) => p.status === 'PUBLISHED');

const ar = (d: string) => new Date(d).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="من نحن" description="سفران مدونة معلوماتية عن السفر والتأشيرات، وليست شركة سياحية ولا منصة حجز." canonical="/about.html" active="about">
  <div class="wrap section">
    <article class="article">
      <nav class="crumbs"><a href="/">الرئيسية</a> / من نحن</nav>
      <h1>من نحن</h1>

      <div class="prose">
        <p><strong>سفران مدونة معلوماتية</strong> متخصصة في معلومات السفر والتأشيرات. نكتب أدلة تساعد القارئ على فهم إجراءات السفر والرسوم والشروط، ونربط كل معلومة مهمة بمصدرها الرسمي وتاريخ مراجعتها.</p>

        <p>سفران <strong>ليست</strong> شركة سياحية، ولا وكالة سفر، ولا منصة حجز، ولا جهة تُصدر تأشيرات. لا نبيع رحلات ولا فنادق ولا نقدّم خدمات وساطة، ولا يمكنك إتمام أي حجز من خلال الموقع.</p>

        <h2>ما نقدمه</h2>
        <ul>
          <li>دلائل تأشيرات مفصّلة حسب الدولة والجنسية المذكورة صراحة في كل مقال.</li>
          <li>شرح الشروط والاستثناءات والرسوم التي قد تتغير، مع تاريخ آخر مراجعة.</li>
          <li>روابط مباشرة إلى المصادر الرسمية حين تكون متاحة.</li>
          <li>تمييز واضح بين المعلومة الثابتة والمعلومة المتغيرة.</li>
        </ul>

        <h2>ما لا نفعله</h2>
        <ul>
          <li>لا نختلق تجارب سفر أو زيارات لم تحدث.</li>
          <li>لا ننشر تقييمات أو شهادات غير حقيقية.</li>
          <li>لا نضمن قبول أي طلب تأشيرة — القرار للجهة المختصة وحدها.</li>
          <li>لا نقدّم استشارات قانونية أو هجرة.</li>
        </ul>

        <h2>كيف نعمل</h2>
        <p>نبدأ من سؤال محدد يبحث عنه المسافر، ثم نراجع المصادر الرسمية للدولة المعنية، ثم نكتب الشرح ونضع تاريخ المراجعة. تفاصيل الطريقة كاملة في <a href="/editorial-policy.html">السياسة التحريرية</a>، وطريقة تصحيح الأخطاء في <a href="/corrections.html">سياسة التصحيحات</a>.</p>

        <h2>كيف يُموّل الموقع</h2>
        <p>عبر إعلانات Google AdSense عند تفعيلها. الإعلانات لا تؤثر على اختيار المواضيع ولا على ما نكتبه، ولا توجد روابط تجارية مدفوعة داخل المقالات. التفاصيل في <a href="/disclosure.html">الإفصاح عن الإعلانات</a>.</p>

        <p style="color:var(--muted);font-size:15px">عدد المقالات المنشورة حاليًا: {posts.length}. آخر تحديث لهذه الصفحة: {ar('2026-11-20')}.</p>
      </div>
    </article>
  </div>
</Base>
